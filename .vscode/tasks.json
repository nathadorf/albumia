{
  // « Ouvrir Albumia » se lance tout seul à l'ouverture du dossier dans VS Code
  // (VS Code demande l'autorisation la première fois). Sinon : Ctrl+Maj+B.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "📸 Ouvrir Albumia",
      "type": "shell",
      "command": "python3 lancer.py",
      "windows": { "command": ".\\Albumia.bat" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": false, "clear": true },
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "🧪 Tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m unittest discover -s tests -v",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m unittest discover -s tests -v" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
